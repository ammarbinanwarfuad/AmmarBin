# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# ============================================
# NEXTAUTH AUTHENTICATION
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-characters-long

# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password

# ============================================
# GITHUB API
# ============================================
GITHUB_PAT=github_pat_YOUR_TOKEN_HERE
GITHUB_USERNAME=your-github-username

# ============================================
# EMAIL SERVICE
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# ============================================
# EXTERNAL BLOGS
# ============================================
GUCC_BLOG_URL=https://gucc.green.edu.bd/blog
HASHNODE_USERNAME=your-username
HASHNODE_BLOG_URL=https://your-username.hashnode.dev
MEDIUM_USERNAME=your-username
DEV_TO_USERNAME=your-username

# ============================================
# RECAPTCHA
# ============================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Your Name - Portfolio
NEXT_PUBLIC_APP_DESCRIPTION=Portfolio website

# ============================================
# VERCEL ANALYTICS
# ============================================
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================
# OPTIONAL FEATURES
# ============================================
ENABLE_BLOG_SYNC=true
ENABLE_GITHUB_SYNC=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=false

# ============================================
# VERCEL (for cache purging)
# ============================================
VERCEL_TOKEN=your-vercel-token-here
VERCEL_PROJECT_ID=your-project-id-here

# ============================================
# VERCEL KV (Redis Cache) - OPTIONAL
# ============================================
# Vercel KV is used for Redis caching to improve API performance
# If not configured, the app will work without caching
# To set up:
# 1. Go to your Vercel project dashboard
# 2. Navigate to Storage → Create Database → KV
# 3. Copy the environment variables (they start with KV_)
# 4. Vercel automatically injects these in production
# For local development, copy from Vercel dashboard:
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================================
# To test service worker in development:
# ============================================
NEXT_PUBLIC_ENABLE_SW=true

# Get VERCEL_TOKEN:
# Go to https://vercel.com/account/tokens
# Click "Create Token"
# Name it (e.g., "Cache Purge Token")
# Select "Full Account" or "Project" scope
# Copy the token (shown only once)

# Get VERCEL_PROJECT_ID:
# Go to your Vercel project dashboard
# Settings → General
# Copy the "Project ID"